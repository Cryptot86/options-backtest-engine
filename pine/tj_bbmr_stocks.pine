//@version=5
indicator("TJ BB-MR Stocks (CANDIDATE)", overlay=true)

// ============================================================================
// BOLLINGER MEAN-REVERSION — SHARES ONLY (separate from the options scanner)
// STATUS: CANDIDATE (2026-08-04) — NOT LAW. Pending stock-engine OOS: broad
// universe, 2022 split, parameter plateau, real costs, TSP integration.
// Receipts: 312 trades/11 names/13yr: 71% win, +2.75%/tr, 11d median hold;
// as 20% sleeve on idle stock-account cash beats SGOV null by +1.5 CAGR pts
// at identical DD (MAR 0.71->0.78). NOT a hedge (corr +0.42 in drawdowns).
// KNOWN WEAKNESSES: fat left tail (avg loss -8.8% > avg win +7.4%; worst -48%);
// young IPOs (<2yr) NEGATIVE (ARM -0.27%/tr, RDDT -3.22%/tr) — skip them.
// ============================================================================

lenBB      = input.int(20, "Bollinger length", minval=5)
multBB     = input.float(2.0, "Bollinger mult", step=0.1)
useTrend   = input.bool(false, "Require 10>100 uptrend (tested: NOT better — off by default)")
costBps    = input.float(4.0, "Round-trip cost (bps)", minval=0)
startEq    = input.float(10000, "Starting equity $", minval=100)
showTable  = input.bool(true, "Show statistics table")

basis = ta.sma(close, lenBB)
dev   = multBB * ta.stdev(close, lenBB)
lower = basis - dev
upper = basis + dev
e10   = ta.ema(close, 10)
e100  = ta.ema(close, 100)
trendOK = not useTrend or e10 > e100

plot(basis, "SMA20", color=color.new(color.orange, 0))
plot(lower, "lower band", color=color.new(color.teal, 30))
plot(upper, "upper band", color=color.new(color.gray, 70))

// ---- position state (confirmed bars only — no repaint) ----
var bool  inPos   = false
var float entryPx = na
var int   entryBar= na
var int   nTrades = 0
var int   nWins   = 0
var float sumRet  = 0.0
var float sumHold = 0.0
var float eq      = na
var float bh0     = na
if na(eq)
    eq  := startEq
    bh0 := close

entrySig = not inPos and close < lower and trendOK and barstate.isconfirmed
exitSig  = inPos and close >= basis and barstate.isconfirmed

if entrySig
    inPos := true
    entryPx := close
    entryBar := bar_index
if exitSig
    r = close / entryPx - 1 - costBps / 10000.0
    nTrades += 1
    nWins   += r > 0 ? 1 : 0
    sumRet  += r
    sumHold += bar_index - entryBar
    eq      *= (1 + r)
    inPos := false

plotshape(entrySig, "BB-MR BUY", shape.triangleup, location.belowbar,
     color=color.new(color.teal, 0), size=size.small, text="MR buy")
plotshape(exitSig, "BB-MR EXIT", shape.xcross, location.abovebar,
     color=color.new(color.orange, 0), size=size.small, text="exit")

// open-position card line
openRet = inPos ? close / entryPx - 1 : na

if showTable and barstate.islast
    var table tb = table.new(position.top_right, 2, 9, border_width=1)
    hdr = color.new(#1a3a5c, 0)
    row = color.new(#2A2E39, 0)
    wht = color.white
    table.cell(tb, 0, 0, "BB-MR SHARES", bgcolor=hdr, text_color=wht)
    table.cell(tb, 1, 0, "CANDIDATE — not law (OOS pending)", bgcolor=hdr, text_color=color.yellow)
    table.cell(tb, 0, 1, "rule", bgcolor=row, text_color=wht)
    table.cell(tb, 1, 1, "buy close < lower BB · sell close ≥ SMA" + str.tostring(lenBB), bgcolor=row, text_color=wht)
    table.cell(tb, 0, 2, "trades", bgcolor=row, text_color=wht)
    table.cell(tb, 1, 2, str.tostring(nTrades), bgcolor=row, text_color=wht)
    table.cell(tb, 0, 3, "win %", bgcolor=row, text_color=wht)
    table.cell(tb, 1, 3, nTrades > 0 ? str.tostring(100.0 * nWins / nTrades, "#.1") + "%" : "—", bgcolor=row, text_color=wht)
    table.cell(tb, 0, 4, "avg / trade", bgcolor=row, text_color=wht)
    table.cell(tb, 1, 4, nTrades > 0 ? str.tostring(100.0 * sumRet / nTrades, "#.2") + "%" : "—", bgcolor=row, text_color=wht)
    table.cell(tb, 0, 5, "avg hold", bgcolor=row, text_color=wht)
    table.cell(tb, 1, 5, nTrades > 0 ? str.tostring(sumHold / nTrades, "#.0") + " bars" : "—", bgcolor=row, text_color=wht)
    table.cell(tb, 0, 6, "$" + str.tostring(startEq, "#") + " →", bgcolor=row, text_color=wht)
    table.cell(tb, 1, 6, "$" + str.tostring(eq, "#,###") + "   (B&H: $" +
         str.tostring(startEq * close / bh0, "#,###") + ")", bgcolor=row, text_color=wht)
    table.cell(tb, 0, 7, "position", bgcolor=row, text_color=wht)
    table.cell(tb, 1, 7, inPos ? "LONG from $" + str.tostring(entryPx, "#.##") + "  (" +
         str.tostring(100 * openRet, "#.1") + "%)" : "flat — waiting for dip < lower band",
         bgcolor=inPos ? color.new(#0E6B4F, 0) : row, text_color=wht)
    table.cell(tb, 0, 8, "⚠ skip", bgcolor=row, text_color=wht)
    table.cell(tb, 1, 8, "IPOs < 2yr (ARM/RDDT-class tested NEGATIVE)", bgcolor=row, text_color=color.new(color.orange, 10))

alertcondition(entrySig, "TJ BB-MR: BUY", "BB-MR candidate: close below lower band — buy shares")
alertcondition(exitSig, "TJ BB-MR: EXIT", "BB-MR candidate: close at SMA20 — sell shares")
